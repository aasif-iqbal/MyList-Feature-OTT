{
  "name": "my-list",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "ts-node-dev --respawn src/app.ts",
    "build": "tsc",
    "test": "jest --runInBand --detectOpenHandles",
    "seed": "ts-node seed/seed.ts",
    "docker:dev": "docker-compose up --build",
    "docker:test": "docker-compose -f docker-compose.yml -f docker-compose.ci.yml run --rm test",
    "docker:seed": "docker-compose run --rm app npm run seed"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.5",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
